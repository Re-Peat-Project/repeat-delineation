<mxfile host="app.diagrams.net"><diagram name="sub-KHG delineation"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Sub-KHG delineation (repeat-delineation)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="34" as="geometry"/></mxCell><mxCell id="s" value="python -m repeat_delineation --config delineate.yaml. Steps as in src/repeat_delineation/delineate.py; values in brackets are the defaults (units.subkhg in the config overrides them). Blue: inputs. Purple: steps, top to bottom. Orange: files written. Green: modules that read them." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="40" as="geometry"/></mxCell><mxCell id="laneA" value="Inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="10" y="96" width="290" height="1280" as="geometry"/></mxCell><mxCell id="laneB" value="Processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf6fc;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="540" height="1280" as="geometry"/></mxCell><mxCell id="laneC" value="Outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="890" y="96" width="300" height="1280" as="geometry"/></mxCell><mxCell id="laneD" value="Read by" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6fbf5;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1210" y="96" width="280" height="1280" as="geometry"/></mxCell><mxCell id="khg" value="&lt;b&gt;KHG polygon&lt;/b&gt;&lt;br&gt;khg (16.02.01_sugihan_lumpur/00_inputs/khg.gpkg)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="270" height="74" as="geometry"/></mxCell><mxCell id="dtm" value="&lt;b&gt;Ground DTM&lt;/b&gt;&lt;br&gt;rasters.dtm: dtm_smooth.tif from repeat-dem, or LiDAR. A DSM gives wrong catchments" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="226" width="270" height="74" as="geometry"/></mxCell><mxCell id="riv" value="&lt;b&gt;Rivers, lakes&lt;/b&gt;&lt;br&gt;vectors.rivers, vectors.lakes: always boundaries" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="322" width="270" height="74" as="geometry"/></mxCell><mxCell id="can" value="&lt;b&gt;Canals&lt;/b&gt;&lt;br&gt;vectors.canals, class column canal_class_field (here KET_KANAL: Primer, Sekunder, Tersier)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="418" width="270" height="74" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;1. Grid&lt;/b&gt;&lt;br&gt;UTM grid at grid_res_m (30 m) over the KHG plus 1 km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="520" height="74" as="geometry"/></mxCell><mxCell id="w" value="&lt;b&gt;2. DTM onto the grid&lt;/b&gt;&lt;br&gt;bilinear warp; KHG mask; cells without DTM leave the KHG (warning if more than 1%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="226" width="520" height="74" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;3. Channel masks&lt;/b&gt;&lt;br&gt;rivers + lakes; all canals; &lt;b&gt;outlet canals&lt;/b&gt; = canals whose class is in outlet_canal_classes (primer, primary; site config: Kanal Primer). Outlet set = rivers + outlet canals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="322" width="520" height="170" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;4. Burn&lt;/b&gt;&lt;br&gt;DTM lowered by burn_depth_m (3 m) under rivers and all canals (canals are narrower than a cell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="514" width="520" height="74" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;5. Condition and route&lt;/b&gt; (pysheds)&lt;br&gt;fill pits, fill depressions, resolve flats; D8 flow direction; flow accumulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="610" width="520" height="74" as="geometry"/></mxCell><mxCell id="so" value="&lt;b&gt;6. DEM streams&lt;/b&gt;&lt;br&gt;accumulation ≥ stream_threshold_km2 (2 km²); Strahler order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="706" width="520" height="74" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;7. Choose the outlet set&lt;/b&gt;&lt;br&gt;first the mapped outlets alone; if the unit count is outside target_count (6-30), add DEM streams of order ≥ k, k from the highest order down (or outlet_order fixed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="802" width="520" height="74" as="geometry"/></mxCell><mxCell id="pc" value="&lt;b&gt;8. Pieces&lt;/b&gt;&lt;br&gt;outlet network cut into reaches at junctions; every cell traced down D8 to its first outlet cell = the catchment of that reach; split at divides into connected banks. Flow leaving the KHG without an outlet = coastal catchment, cut into pieces of about coastal_split_km2 (50 km²)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="898" width="520" height="74" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;9. Merge small pieces&lt;/b&gt; (merge: adjacent)&lt;br&gt;pieces under min_area_km2 join, smallest first, the neighbour they share the longest &lt;i&gt;divide&lt;/i&gt; border with (a border across an outlet channel only if there is no divide neighbour). min_area_km2: auto = start at 5 km², raise 10% at a time until at most 30 units remain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="994" width="520" height="170" as="geometry"/></mxCell><mxCell id="fn" value="&lt;b&gt;10. Units&lt;/b&gt;&lt;br&gt;channel cells go to the nearest unit; clip to the KHG; polygonise; named &amp;lt;khg_id&amp;gt;_S01, _S02 ... north to south" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1186" width="520" height="170" as="geometry"/></mxCell><mxCell id="fb" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;no flow directions (use_dem_streams: false, or step 5 fails): units = land enclosed by the mapped outlets; target_count ignored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="270" height="170" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;flow_accumulation.tif&lt;/b&gt;&lt;br&gt;cache/&amp;lt;khg&amp;gt;/static/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="280" height="74" as="geometry"/></mxCell><mxCell id="ord" value="&lt;b&gt;stream_order.tif&lt;/b&gt;&lt;br&gt;cache/&amp;lt;khg&amp;gt;/static/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="706" width="280" height="74" as="geometry"/></mxCell><mxCell id="un" value="&lt;b&gt;subkhg_units.gpkg&lt;/b&gt;&lt;br&gt;&amp;lt;out&amp;gt;/ (khg_id, unit_id, geometry); also cache/&amp;lt;khg&amp;gt;/subkhg.gpkg" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="1186" width="280" height="74" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;delineation_report.json&lt;/b&gt;&lt;br&gt;settings, inputs, pieces, units, areas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="1282" width="280" height="74" as="geometry"/></mxCell><mxCell id="nr" value="&lt;b&gt;repeat-neraca&lt;/b&gt;&lt;br&gt;water balance per unit (units: in neraca.yaml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1220" y="1186" width="260" height="74" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;repeat-prioritisation subkhg&lt;/b&gt;&lt;br&gt;units: {mode: vector, path: subkhg_units.gpkg}; dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1220" y="1282" width="260" height="74" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="khg" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="dtm" target="w"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.2176;entryDx=0;entryDy=0;" edge="1" parent="1" source="riv" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.7824;entryDx=0;entryDy=0;" edge="1" parent="1" source="can" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="w"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="w" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="so"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="so" target="os"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="pc" target="mg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="mg" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="acc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="so" target="ord"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7432;exitDx=0;exitDy=0;entryX=1;entryY=0.2176;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="d8" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2176;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="un"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7824;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="rp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="un" target="nr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7703;exitDx=0;exitDy=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="un" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;16.02.01_sugihan_lumpur, last run&lt;/b&gt;&lt;br&gt;14928 canal segments (Kanal Tersier 10541, Kanal Sekunder 3764, Kanal Primer 623); outlets: Kanal Primer, Kanal Sekunder&lt;br&gt;21018 pieces before merging → 30 units; minimum area 105.6 km² (auto); unit area 113.0 to 373.0 km² (median 207.9)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1428" width="560" height="72" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Stability&lt;/b&gt; (02_delineation/stability/, python -m repeat_delineation.stability)&lt;br&gt;primary: noise members agree ARI 0.471; DTMs vs LiDAR 0.48; flat surface vs LiDAR 0.348; 24-30 units&lt;br&gt;primary_secondary: noise members agree ARI 0.633; DTMs vs LiDAR 0.629; flat surface vs LiDAR 0.601; 26-30 units&lt;br&gt;primary_secondary_flow: noise members agree ARI 0.603; DTMs vs LiDAR 0.606; flat surface vs LiDAR 0.569; 26-30 units&lt;br&gt;ARI: adjusted Rand index of two partitions, 1 = identical, 0 = chance." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="600" y="1428" width="560" height="72" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Where the boundaries come from&lt;/b&gt;&lt;br&gt;mapped outlets (rivers, outlet canals) are fixed boundaries; inside them the DTM only decides the divides (steps 4-8), and step 9 decides which pieces join. Without outlets inside the KHG, small DTM changes move the divides and the merges" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1180" y="1428" width="330" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>